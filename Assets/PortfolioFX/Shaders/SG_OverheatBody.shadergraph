{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3af6691523c144bab7a4c5261c5c7d96",
    "m_Title": "New Note",
    "m_Content": "edge：已经烧焦的区域向未烧焦区域扩时的亮边/亮边，最后乘 hot，是为了让亮边随 gate 一起关闭，并削弱前沿外侧部分。所以 band 两侧对称，最终 edge 不一定对称。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1238.6666259765625,
        "y": 1352.6666259765625,
        "width": 200.0,
        "height": 154.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

