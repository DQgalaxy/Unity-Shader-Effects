{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "3df40834829c46658afa80149e9a6c50",
    "m_Title": "New Note",
    "m_Content": "gate：为什么需要这个开关？因为距离中加了噪声，即使 Radius=0，受击点附近仍可能被噪声推入“烧焦区域”。乘上 gate 后，Progress=0 就能保证效果关闭。",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 522.6666870117188,
        "y": 973.3333740234375,
        "width": 200.0,
        "height": 159.99993896484376
    },
    "m_Group": {
        "m_Id": ""
    }
}

